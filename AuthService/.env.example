# Render tarafından sağlanan port; yerelde varsayılan 3000 kullanılır.
PORT=3000
NODE_ENV=production

# Render PostgreSQL bağlantı adresi.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Yalnızca veritabanı sağlayıcın SSL gerektiriyorsa true yap.
DATABASE_SSL=false

# Sadece hesap deposuna Contents: Read yetkisi olan GitHub fine-grained token.
GITHUB_TOKEN=github_pat_REPLACE_ME
GITHUB_OWNER=YOUR_GITHUB_OWNER
GITHUB_REPO=ytmt-studio-auth-data
GITHUB_BRANCH=main
GITHUB_ACCOUNTS_PATH=auth/accounts.json

# GitHub hesap dosyası önbellek süresi (5–60 saniye arasında sınırlandırılır).
GITHUB_CACHE_SECONDS=15